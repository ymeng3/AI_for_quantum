\\\",FontSize->14]\\)\"", 
        InterpretationBox[
         StyleBox[
          GridBox[{{
             SliderBox[
              Dynamic[$CellContext`l$$, If[
                And[
                 IntegerQ[#], # > 0], $CellContext`l$$ = #; $CellContext`ab$$ = 
                 PadRight[$CellContext`ab$$, $CellContext`l$$, {
                    Part[$CellContext`ab$$, 1]}]; $CellContext`atoms$$ = 
