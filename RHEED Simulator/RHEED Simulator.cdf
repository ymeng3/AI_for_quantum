              ContinuousAction -> False, BaseStyle -> "Text", Appearance -> 
              Automatic, DefaultBaseStyle -> "LabeledSlider"], 
             InputFieldBox[
              Dynamic[$CellContext`l$$, If[
                And[
                 IntegerQ[#], # > 0], $CellContext`l$$ = #; $CellContext`ab$$ = 
                 PadRight[$CellContext`ab$$, $CellContext`l$$, {
                    Part[$CellContext`ab$$, 1]}]; $CellContext`atoms$$ = 
                 PadRight[$CellContext`atoms$$, $CellContext`l$$, {{{0, 0, 
